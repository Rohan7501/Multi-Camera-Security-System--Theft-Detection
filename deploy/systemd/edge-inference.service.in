# systemd USER unit — install to ~/.config/systemd/user/edge-inference.service
# C++ service (ONNX Runtime + TensorRT). Needs the sandboxed CUDA/cuDNN/TRT/ORT
# libs on LD_LIBRARY_PATH. The control service owns EnvironmentFile
# (FleetController.configure renders it); systemd owns supervision + ordering.

[Unit]
Description=edge-ai inference service
After=network-online.target
Wants=network-online.target
# Dependency chain: tracking -> inference -> ingest. Inference dials tracking at
# startup; its TrackingClient self-heals, so a too-early start costs only the
# frames sent while tracking is unreachable, not the stream. It creates the shm
# segment; ingest starts after inference.
After=edge-tracking.service
Before=edge-ingest.service

[Service]
Type=simple
# Same user across ALL edge units: it creates the shm segment 0600, so the Python
# tracking/display consumers must share this owner to read it.
# User=rohan
# Group=rohan
WorkingDirectory=@SEC_SYS_ROOT_DIR@
# Launch-time config, rendered by the control service:
EnvironmentFile=@EDGE_AI_ETC@/inference.env
# Sandboxed CUDA/cuDNN/TensorRT/ORT libs (see scripts/run_inference.sh):
Environment=LD_LIBRARY_PATH=@SEC_SYS_ROOT_DIR@/dependency/TensorRT-10.8.0.43/lib:@SEC_SYS_ROOT_DIR@/dependency/cudnn-9.23.2.1/lib:@SEC_SYS_ROOT_DIR@/dependency/cuda_12.8.0/lib64:@SEC_SYS_ROOT_DIR@/dependency/onnxruntime-linux-x64-gpu-1.22.0/lib
ExecStart=@SEC_SYS_ROOT_DIR@/build/services/inference_service/inference_service
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
