# systemd USER unit — install to ~/.config/systemd/user/edge-tracking.service
# Python service: runs `python3 main.py` from its own dir (flat imports), no native libs.
# The control service owns EnvironmentFile (FleetController.configure renders it);
# systemd owns supervision, ordering, restart-on-crash.

[Unit]
Description=edge-ai tracking service
After=network-online.target
Wants=network-online.target
# Start tracking before inference dials :50052. After= orders starts, not
# readiness -- inference's TrackingClient reconnects on its own, so this is about
# not dropping the first frames rather than correctness.
Before=edge-inference.service

[Service]
Type=simple
# Same user across ALL edge units: the shm segment is created 0600, so producer
# and consumer must share an owner (or use a shared group).
# User=rohan
# Group=rohan
# Flat imports (import services_pb2, ...) require running from the service dir.
WorkingDirectory=@SEC_SYS_ROOT_DIR@/services/tracking_service
# Launch-time config, rendered by the control service:
EnvironmentFile=@EDGE_AI_ETC@/tracking.env
ExecStart=/usr/bin/python3 main.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
