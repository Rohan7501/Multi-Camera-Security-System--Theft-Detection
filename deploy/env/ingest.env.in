# edge-ai ingest — launch-time env. Install to /etc/edge-ai/ingest.env
# (EnvironmentFile= in edge-ingest.service). systemd env-file syntax: KEY=VALUE,
# one per line, NO quotes/expansion/export. Restart to apply changes.
#
# FRAME_TRANSPORT must be IDENTICAL in ingest.env / inference.env / tracking.env
# -- the C++ checkTransport handshake aborts a peer on mismatch.

# where frames live: shm (ring) | grpc (inline on the wire)
FRAME_TRANSPORT=shm

# the inference gRPC server ingest pushes frames to
INFERENCE_ADDR=localhost:50051

# ingest's own runtime camera-control plane (control_service dials this)
INGEST_ADMIN_ADDR=127.0.0.1:50053
