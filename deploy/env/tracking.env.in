# edge-ai tracking — launch-time env. Install to /etc/edge-ai/tracking.env
# (EnvironmentFile= in edge-tracking.service). systemd env-file syntax: KEY=VALUE.
#
# FRAME_TRANSPORT must match ingest.env / inference.env. TRACKING_PIXELS must
# match inference.env. (Tracking binds :50052 via the `python3 main.py` default,
# which is the TRACKING_ADDR inference dials -- it is a CLI arg, not an env var.)

# where frames live: shm | grpc  (must match the fleet)
FRAME_TRANSPORT=shm

# does THIS tracker consume pixels? ByteTrack does not -> 0. Set 1 only for an
# appearance/re-ID tracker (then set inference.env TRACKING_PIXELS=1 too).
TRACKING_PIXELS=0

# feed the standalone display_service (writes /dev/shm/edge-display/<stream>.json)
DISPLAY_PUBLISH=1

# in-process cv2 overlay window -- OFF under systemd (headless, no X DISPLAY)
DISPLAY_DETECTIONS=0

# event_service (alerts + day-one detection log) data root
EVENT_DATA_DIR=@SEC_SYS_ROOT_DIR@/data

# --- optional ---
# DASHBOARD_URL=http://127.0.0.1:8000/alerts   # POST each alert here if set
# DISPLAY_FEED_DIR=/dev/shm/edge-display        # tracking<->display feed (default)
# TRACKING_ALGO=bytetrack                        # rendered but not yet wired
