# edge-ai inference — launch-time env. Install to /etc/edge-ai/inference.env
# (EnvironmentFile= in edge-inference.service). systemd env-file syntax: KEY=VALUE.
#
# FRAME_TRANSPORT must match ingest.env / tracking.env (checkTransport aborts on
# mismatch). TRACKING_PIXELS must match tracking.env (both sides agree on whether
# pixels ride the detection hop).

# where frames live: shm | grpc  (must match the fleet)
FRAME_TRANSPORT=shm

# TrackingService inference forwards detections to (dialed at startup, no reconnect)
TRACKING_ADDR=127.0.0.1:50052

# does the tracker consume pixels? 1 => in grpc mode inference inlines the frame
# on the detection hop. ByteTrack ignores pixels, so default 0. Keep == tracking.env.
TRACKING_PIXELS=0

# safety net: skip a frame whose capture age is already over this many ms when a
# worker takes it (counted in inference_frame_stale_total). Healthy runs stay well
# under it. 0 disables.
INFERENCE_MAX_AGE_MS=40

# --- rendered by control_service but NOT yet read by the binary (future) ---
# EXECUTION_PROVIDER=Auto        # Auto|CUDA|TensorRT|CPU
# WORKER_COUNT=2
# BATCH_SIZE=1
# INFERENCE_BIND=127.0.0.1:50051 # server currently binds this address hard-coded
