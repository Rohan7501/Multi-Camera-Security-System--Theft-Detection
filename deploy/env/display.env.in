# edge-ai display — env. Install to /etc/edge-ai/display.env
# (EnvironmentFile= in edge-display.service).

# CRITICAL: the units are --user units, so /start-up must call `systemctl --user`.
# systemd-user selects SystemdBackend(user=True) in the FleetController facade.
LIFECYCLE_BACKEND=systemd-user

# event_service data root (for /alerts and the SQLite the dashboard reads)
EVENT_DATA_DIR=@SEC_SYS_ROOT_DIR@/data

# --- optional ---
# DISPLAY_FEED_DIR=/dev/shm/edge-display   # tracking<->display detection feed (default)
# DISPLAY_FPS=15                            # MJPEG cap per viewer
